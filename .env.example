# Set these only in the Convex dashboard, not in Vercel or client-side env files.
# AUDIT_PASSCODE remains supported as a legacy alias for AUDIT_EDITOR_PASSCODE.
AUDIT_EDITOR_PASSCODE=choose-a-strong-editor-passcode
AUDIT_GENERAL_VIEW_PASSCODE=choose-a-general-view-passcode
AUDIT_COM_VIEW_PASSCODE=choose-a-com-view-passcode
AUDIT_NORDONE_VIEW_PASSCODE=choose-a-nordone-view-passcode
AUDIT_VIA_VIEW_PASSCODE=choose-a-via-view-passcode
AUDIT_VIVALIA_VIEW_PASSCODE=choose-a-vivalia-view-passcode

# Required only after the translation feature is deployed. Set in the Convex
# dashboard, never in Vercel or a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=

# Convex writes this during local setup. Vercel receives it during `convex deploy`.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Add a production or preview deploy key in Vercel.
CONVEX_DEPLOY_KEY=
